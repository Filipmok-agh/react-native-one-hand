{
  "name": "react-native-one-hand",
  "version": "0.1.0",
  "description": "One-hand mode for React Native: scales the entire app — including native modals, alerts and action sheets — and docks it into a bottom corner, within thumb's reach. iOS + Android.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "react-native": "src/index.ts",
  "files": [
    "src",
    "!src/**/__tests__",
    "!src/**/__mocks__",
    "ios",
    "android",
    "!android/build",
    "!android/.gradle",
    "expo-module.config.json",
    "README.md",
    "ARCHITECTURE.md",
    "KEYBOARD-FINDINGS.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"*.{json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"*.{json,md}\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "keywords": [
    "react-native",
    "expo",
    "ios",
    "android",
    "one-hand",
    "one-handed",
    "one-handed-mode",
    "reachability",
    "accessibility",
    "modal",
    "window"
  ],
  "license": "MIT",
  "author": "Filip Mokrzycki",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Filipmok-agh/react-native-one-hand.git"
  },
  "homepage": "https://github.com/Filipmok-agh/react-native-one-hand#readme",
  "bugs": {
    "url": "https://github.com/Filipmok-agh/react-native-one-hand/issues"
  },
  "peerDependencies": {
    "expo": ">=55.0.0",
    "react": ">=18.0.0",
    "react-native": ">=0.76.0",
    "react-native-safe-area-context": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "react-native-safe-area-context": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^9.39.5",
    "@react-native/babel-preset": "^0.85.3",
    "@react-native/jest-preset": "^0.85.3",
    "@testing-library/react-native": "^13.2.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "babel-jest": "^29.7.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.8.4",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.46.0"
  }
}
